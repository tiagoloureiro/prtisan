{
  "name": "prtisan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.22",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "prtisan": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outdir=dist --packages=external && chmod +x dist/index.js && mkdir -p dist/vendor && cp -R src/vendor/code-review dist/vendor/",
    "dev": "bun run src/index.ts",
    "prtisan": "bun run src/index.ts",
    "link-bin": "bun run build && bun link",
    "release:pack": "mkdir -p release && rm -f release/*.tgz release/SHA256SUMS && bun run build && bun pm pack --destination release && sha256sum release/*.tgz > release/SHA256SUMS",
    "init": "bun run src/index.ts init",
    "plan": "bun run src/index.ts plan",
    "lint": "eslint .",
    "format": "prettier --ignore-unknown --write .",
    "format:check": "prettier --ignore-unknown --check .",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.2.22",
    "bun": "1.2.22",
    "eslint": "^10.7.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
