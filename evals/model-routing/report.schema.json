{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tiagoloureiro/prtisan/evals/model-routing/report.schema.json",
  "title": "Prtisan redacted model-routing report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "corpusDigest",
    "generatedAt",
    "rateCard",
    "totals",
    "roles"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string" },
    "corpusDigest": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "rateCard": {
      "type": "object",
      "required": ["id", "url", "accessedAt"]
    },
    "totals": {
      "type": "object",
      "required": [
        "samples",
        "completedSamples",
        "credits",
        "unavoidableOvershootCredits",
        "tokenMix"
      ]
    },
    "roles": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["role", "recommendation", "candidates"]
      }
    }
  }
}
